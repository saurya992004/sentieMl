# Use a PostgreSQL URL in production, e.g. postgresql+psycopg://sentinelml:change-me@localhost:5432/sentinelml
DATABASE_URL=sqlite:///./sentinelml.db
MLFLOW_TRACKING_URI=sqlite:///./mlflow.db
MLFLOW_ARTIFACT_ROOT=./mlruns
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=25
CORS_ORIGINS=http://localhost:5173
# Docker Compose infrastructure values. Change these before shared deployment.
POSTGRES_DB=sentinelml
POSTGRES_USER=sentinelml
POSTGRES_PASSWORD=change-this-postgres-password
POSTGRES_MLFLOW_DB=mlflow
MINIO_ROOT_USER=sentinelml
MINIO_ROOT_PASSWORD=change-this-minio-password
MLFLOW_BUCKET=mlflow
AWS_DEFAULT_REGION=us-east-1
VITE_API_URL=http://localhost:8000
# Google Gemini Generative MLOps Intelligence (Optional: grab a free key from https://aistudio.google.com/)
GEMINI_API_KEY=your-gemini-api-key-here
